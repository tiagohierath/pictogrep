#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$SOURCE_DIR/$SOURCE" ;;
  esac
done
DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

if [ -n "${BILDKASTEN_LIBSTDCPP:-}" ]; then
  export LD_LIBRARY_PATH="$BILDKASTEN_LIBSTDCPP${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
elif [ -d /nix/store/hngmi01i8wgi25a0byrxcn4ysz5j79mw-gcc-15.2.0-lib/lib ]; then
  export LD_LIBRARY_PATH="/nix/store/hngmi01i8wgi25a0byrxcn4ysz5j79mw-gcc-15.2.0-lib/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

usage() {
  cat <<'EOF'
Bildkasten

Usage:
  bildkasten                  open the terminal UI
  bildkasten setup            create .venv and install Python packages
  bildkasten install-user     link bildkasten into ~/.local/bin
  bildkasten doctor           check dependencies, index, and viewer
  bildkasten version          print version
  bildkasten paths            show local data and tag folders
  bildkasten index [folder]   build/rebuild the image index
  bildkasten tags ...         create, fill, and send editable image tags
  bildkasten storyboard       open the browser storyboard doodle tool
  bildkasten search "query"   search from the shell and open results
  bildkasten "query"          search from the shell and open results

Examples:
  bildkasten setup
  bildkasten install-user
  bildkasten index ~/Pictures/reference
  bildkasten tags fill cinematic "cinematic moody composition" --limit 50
  bildkasten
  bildkasten storyboard
  bildkasten search "red cloak" --limit 12 --print
  bildkasten "red cloak" --limit 12 --print
EOF
}

if [ "${1:-}" = "help" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

if [ "${1:-}" = "setup" ]; then
  PYTHON_BIN="${PYTHON:-python3}"
  "$PYTHON_BIN" -m venv "$DIR/.venv"
  source "$DIR/.venv/bin/activate"
  python -m pip install --upgrade pip
  python -m pip install -r "$DIR/requirements.txt"
  echo
  echo "Setup complete."
  echo "Next: $0 install-user"
  echo "Then: bildkasten index /path/to/images"
  echo "Then: bildkasten"
  exit 0
fi

if [ "${1:-}" = "install-user" ]; then
  USER_BIN_DIR="${BILDKASTEN_USER_BIN_DIR:-${HOME}/.local/bin}"
  TARGET="$USER_BIN_DIR/bildkasten"
  mkdir -p "$USER_BIN_DIR"
  if [ -e "$TARGET" ] && [ ! -L "$TARGET" ]; then
    echo "Refusing to overwrite non-symlink: $TARGET" >&2
    exit 1
  fi
  ln -sfn "$DIR/bin/bildkasten" "$TARGET"
  echo "Installed: $TARGET -> $DIR/bin/bildkasten"
  if command -v bildkasten >/dev/null 2>&1 && [ "$(command -v bildkasten)" = "$TARGET" ]; then
    echo "You can now run: bildkasten"
  else
    echo "Add this to PATH if needed: $USER_BIN_DIR"
  fi
  exit 0
fi

if [ -d "$DIR/.venv" ]; then
  source "$DIR/.venv/bin/activate"
elif [ -d "$DIR/venv" ]; then
  source "$DIR/venv/bin/activate"
fi

case "${1:-}" in
  doctor)
    python "$DIR/src/doctor.py"
    ;;
  version|--version)
    python -c "import sys; sys.path.insert(0, '$DIR/src'); from bildkasten_core import VERSION; print('bildkasten ' + VERSION)"
    ;;
  paths)
    python -c "import sys; sys.path.insert(0, '$DIR/src'); from bildkasten_core import BASE, COLLECTIONS_DIR, DATA_DIR; print('home:        ' + str(BASE)); print('index:       ' + str(DATA_DIR)); print('tags:        ' + str(COLLECTIONS_DIR)); print('storyboards: ' + str(BASE / 'storyboards'))"
    ;;
  index)
    shift
    python "$DIR/src/build_index.py" "$@"
    ;;
  collections|collection|folders|tags|tag)
    shift
    python "$DIR/src/manage_collections.py" "$@"
    ;;
  storyboard|story|board|sb)
    shift
    python "$DIR/src/storyboard.py" "$@"
    ;;
  search)
    shift
    python "$DIR/src/build_index.py" --refresh --quiet-if-fresh
    python "$DIR/src/search.py" "$@"
    ;;
  "")
    python "$DIR/src/build_index.py" --refresh --quiet-if-fresh
    python "$DIR/src/tui.py"
    ;;
  *)
    python "$DIR/src/build_index.py" --refresh --quiet-if-fresh
    python "$DIR/src/search.py" "$@"
    ;;
esac
